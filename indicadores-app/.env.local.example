# Variables de entorno para indicadores-app
# Copiá este archivo a `.env.local` y completá los valores.
# `.env.local` está ignorado por git (ver .gitignore: `.env*`). NO lo commitees.

# URL del proyecto Supabase (pública, expuesta al cliente)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima/pública de Supabase (pública, expuesta al cliente; respeta RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role de Supabase (SECRETA, solo servidor; omite RLS).
# Úsala únicamente en código server-side (migraciones, tareas admin). NUNCA la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=
